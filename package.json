{
  "name": "a11y-overflow-nav",
  "version": "0.1.0",
  "description": "Accessible Priority+ overflow navigation that moves source-ordered items into an A11y Menu Button disclosure when space runs out.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./docs": {"types": "./dist/docs.d.ts", "import": "./dist/docs.js"},
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run test && npm run typecheck && npm run build && changeset publish"
  },
  "repository": {"type": "git", "url": "git+https://github.com/vmitsaras/A11y-Overflow-Nav.git"},
  "homepage": "https://github.com/vmitsaras/A11y-Overflow-Nav",
  "bugs": {"url": "https://github.com/vmitsaras/A11y-Overflow-Nav/issues"},
  "author": "Vasileios Mitsaras",
  "license": "MIT",
  "keywords": ["accessibility", "a11y", "navigation", "overflow", "priority-plus", "typescript"],
  "dependencies": {"a11y-menu-button": "^1.0.1"},
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "happy-dom": "^20.11.0",
    "tsdown": "^0.22.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
